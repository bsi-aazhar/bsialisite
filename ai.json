        {
            "title": "Resignation",
            "key": "resignation_panel",
            "type": "panel",
            "input": false,
            "tableView": false,
            "components": [
                {
                    "label": "Please check the applicable statement that relates to your resignation.",
                    "key": "resignation_statement",
                    "type": "radio",
                    "inline": false,
                    "tableView": false,
                    "values": [
                        {
                            "label": "I wish to resign my membership with CPA New Brunswick and will not be continuing my membership with any other CPA Provincial and Bermudian Body. I have read and understood the information provided regarding the resignation process and the consequences.",
                            "value": "resign_no_other_body"
                        },
                        {
                            "label": "I am an active member of another CPA Provincial and Bermudian Body and wish to resign from CPA New Brunswick.",
                            "value": "resign_active_other_body"
                        }
                    ],
                    "input": true
                },
                {
                    "label": "Please indicate the other province",
                    "key": "other_province",
                    "type": "textfield",
                    "input": true,
                    "tableView": true,
                    "conditional": {
                        "show": true,
                        "when": "resignation_statement",
                        "eq": "resign_active_other_body"
                    }
                },
                {
                    "label": "Reason for Resignation",
                    "key": "reason_for_resignation",
                    "type": "textarea",
                    "autoExpand": true,
                    "input": true,
                    "tableView": true
                }
            ]
        },
        {
