            "key": "certificate_panel",
            "type": "panel",
            "input": false,
            "tableView": false,
            "components": [
                {
                    "label": "I will be returning to CPA New Brunswick the following membership certificate(s):",
                    "key": "certificates_returned",
                    "type": "checkbox",
                    "input": false,
                    "tableView": false,
                    "customConditional": "show = false;"
                },
                {
                    "label": "Certificates",
                    "key": "certificates_group",
                    "type": "container",
                    "input": true,
                    "tableView": false,
                    "components": [
                        {
                            "label": "CPA New Brunswick Certificate",
                            "key": "cert_cpanb",
                            "type": "checkbox",
                            "input": true
                        },
                        {
                            "label": "CA Certificate",
                            "key": "cert_ca",
                            "type": "checkbox",
                            "input": true
                        },
                        {
                            "label": "CGA Certificate",
                            "key": "cert_cga",
                            "type": "checkbox",
                            "input": true
                        },
                        {
                            "label": "CMA Certificate",
                            "key": "cert_cma",
                            "type": "checkbox",
                            "input": true
                        }
                    ]
                },
                {
                    "label": "If you do not have your original certificate, please check the applicable box below:",
                    "key": "no_original_label",
                    "type": "content",
                    "html": "<div></div>"
                },
                {
                    "label": "My membership certificate was never issued.",
                    "key": "cert_never_issued",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "My membership certificate is destroyed, lost or the location is unknown. I undertake that if my original certificate is ever recovered, I will forward the certificate forthwith to CPA New Brunswick.",
                    "key": "cert_destroyed_lost_unknown",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "Other, please explain",
                    "key": "cert_other_flag",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "Other explanation",
                    "key": "cert_other_explanation",
                    "type": "textarea",
                    "autoExpand": true,
                    "input": true,
                    "conditional": {
                        "show": true,
                        "when": "cert_other_flag",
                        "eq": "true"
                    }
                }
            ]
        },
        {
