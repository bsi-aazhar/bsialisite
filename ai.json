        {
            "title": "Declaration",
            "key": "declaration_panel",
            "type": "panel",
            "input": false,
            "tableView": false,
            "components": [
                {
                    "label": "I acknowledge that I am aware that CPA New Brunswick has a readmission policy for former members who have resigned their membership in good standing but have not maintained membership with another CPA Provincial or Bermudian Body. To be readmitted in the future, I am aware that I must reapply for membership and meet the readmission requirements that may be in effect at the time. These may include the submission of a readmission application, payment of applicable fees and meeting professional development requirements.",
                    "key": "decl_readmission_policy",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "I undertake that I cannot use a protected designation in New Brunswick which includes acting as a Chartered Professional Accountant, using the Chartered Professional Accountant designation or legacy designation in any form or holding myself out as a Chartered Professional Accountant.",
                    "key": "decl_no_designation_use",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "I acknowledge that, pursuant to Bylaw 2.04, my membership certificate(s) are the property of CPA New Brunswick. Furthermore, I declare that if a membership certificate was issued to me, it has been returned to CPA New Brunswick, destroyed or its location is unknown to me",
                    "key": "decl_cert_property",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "I declare that the information contained on this form is true and complete.",
                    "key": "decl_true_complete",
                    "type": "checkbox",
                    "input": true
                },
                {
                    "label": "Signature",
                    "key": "member_signature",
                    "type": "signature",
                    "width": "100%",
                    "height": "150px",
                    "input": true,
                    "tableView": false
