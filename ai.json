                    "label": "Are you a CPA New Brunswick public practice permit holder, authorized to provide and sign off on public accounting services?",
                    "key": "is_public_practice_permit_holder",
                    "type": "radio",
                    "inline": true,
                    "values": [
                        {
                            "label": "Yes",
                            "value": "yes"
                        },
                        {
                            "label": "No",
                            "value": "no"
                        }
                    ],
                    "input": true
                },
                {
                    "label": "Do you have a CPA New Brunswick professional corporation licence",
                    "key": "has_professional_corp_licence",
                    "type": "radio",
                    "inline": true,
                    "values": [
                        {
